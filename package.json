{
  "name": "@hzrd149/opencode-remote-code",
  "version": "3.0.1",
  "description": "OpenCode plugin that lets AI agents edit and run commands on a remote machine over SSH — Windows (OpenSSH + PowerShell) or POSIX — with zero footprint on the remote side",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "remote-opencode": "dist/cli-main.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "index.js",
    "launchers",
    "CHANGELOG.md",
    "README.zh-CN.md",
    "pic.png"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "prepack": "pnpm run build",
    "dev": "pnpm run build && node scripts/dev.mjs",
    "dev:watch": "tsc --watch",
    "lint": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "test": "pnpm run build && tsx test/run-tests.ts"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.2.7"
  },
  "dependencies": {
    "@opencode/client": "2.2.7",
    "diff": "^9.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.7",
    "@types/node": "^20.0.0",
    "@types/ssh2": "^1.15.5",
    "tsx": "^4.20.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hzrd149/opencode-remote-code.git"
  },
  "bugs": {
    "url": "https://github.com/hzrd149/opencode-remote-code/issues"
  },
  "homepage": "https://github.com/hzrd149/opencode-remote-code#readme",
  "license": "MIT",
  "keywords": [
    "opencode",
    "plugin",
    "ssh",
    "remote",
    "agent",
    "sftp",
    "windows",
    "openssh",
    "powershell",
    "posix"
  ]
}
